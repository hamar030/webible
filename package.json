{
  "name": "webible",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi dev --dotenv .env.local.dev",
    "dev:ntl": "ntl dev",
    "dev:prepare": "nuxi build-module build --stub && nuxi build-module --prepare && nuxi prepare",
    "dev:preview:build": "dev:build && node .output/server/index.mjs",
    "build": "nuxi build",
    "build:bun": "SERVER_PRESET=bun nuxi build",
    "build:ntl": "ntl build --context production",
    "generate": "nuxi generate",
    "generate:ntl": "SERVER_PRESET=netlify-edge nuxi generate",
    "preview": "nuxi preview --dotenv .env.local.production",
    "preview:ntl": "ntl serve --context production",
    "prepack": "nuxi build-module --prepare && nuxi build-module build",
    "postinstall": "nuxi prepare",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fontsource-variable/heebo": "^5.1.0",
    "@fontsource-variable/nunito": "^5.1.0",
    "@fontsource-variable/nunito-sans": "^5.1.0",
    "@pinia/nuxt": "^0.5.5",
    "@trpc/client": "^10.45.2",
    "@trpc/server": "^10.45.2",
    "@types/lodash": "^4.17.13",
    "@vite-pwa/nuxt": "^0.5.0",
    "@vueuse/nuxt": "^10.11.1",
    "daisyui": "^4.12.14",
    "lodash": "^4.17.21",
    "nuxt-swiper": "^1.2.2",
    "pinia": "^2.2.6",
    "pinia-plugin-persistedstate": "^3.2.3",
    "trpc-nuxt": "^0.10.22",
    "vue": "^3.5.13",
    "vue-lodash": "^2.1.2",
    "vue-router": "^4.4.5",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.1.5",
    "@netlify/blobs": "^7.4.0",
    "@nuxt/eslint": "^0.6.1",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/fontaine": "^0.4.4",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@pinia-plugin-persistedstate/nuxt": "^1.2.1",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/eslint-config-prettier": "^10.1.0",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "dotenv": "^16.4.5",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.31.0",
    "nuxt": "^3.14.159",
    "nuxt-headlessui": "^1.2.0",
    "nuxt-lodash": "^2.5.3",
    "postcss": "^8.4.49",
    "postcss-apply": "^0.12.0",
    "postcss-import": "^16.1.0",
    "postcss-nesting": "^13.0.1",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.11",
    "vite-plugin-eslint2": "^5.0.2",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.10"
  }
}
